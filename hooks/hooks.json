{
  "description": "reviewerAgent: the selected codex, pi or claude backend reviews commits and supervises stops (and, with stopContinue on, reroutes AskUserQuestion prompts to the supervisor). All paths resolve under ${CLAUDE_PLUGIN_ROOT}.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh", "${CLAUDE_PLUGIN_ROOT}/commit_hook.py"],
            "timeout": 3600
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh", "${CLAUDE_PLUGIN_ROOT}/askq_reroute_hook.py"],
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh", "${CLAUDE_PLUGIN_ROOT}/session_start_hook.py"],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh", "${CLAUDE_PLUGIN_ROOT}/stop_hook.py"],
            "timeout": 630
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh", "${CLAUDE_PLUGIN_ROOT}/userpromptsubmit_hook.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
